# Shared by the existing Java backend and Python service.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_existing_password
NEO4J_DATABASE=neo4j

# Local Redis/Memurai used by P4-P5 dynamic snapshots.
# No-password local Redis/Memurai example:
REDIS_URL=redis://localhost:6379/0
# If authentication is enabled, use an URL-encoded password:
# REDIS_URL=redis://:your_password@localhost:6379/0

# Standard grid source inside python-training-service.
DONGJIN_SIMBENCH_CODE=1-MV-urban--0-sw
DONGJIN_GRID_DATA_DIR=artifacts/grids
DONGJIN_SCENARIO_DATA_DIR=artifacts/scenarios
DONGJIN_DATASET_DIR=artifacts/datasets
DONGJIN_OFFLINE_MODEL_DIR=artifacts/models
DONGJIN_SIMULATION_INTERVAL_SECONDS=1.0
DONGJIN_INTERPOLATION_STRATEGY=linear
DONGJIN_PROFILE_START_TIME=2016-01-01T00:00:00+00:00
DONGJIN_PROFILE_INTERVAL_SECONDS=900
# wrap continuously reuses the generic SimBench profile year; stop enters ERROR at the end.
DONGJIN_PROFILE_END_BEHAVIOR=wrap
DONGJIN_SNAPSHOT_TTL_SECONDS=600
DONGJIN_HEALTH_TIMEOUT_SECONDS=2.0
